{
	"name": "DF_Cleanse_Orders",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Blob_Orders",
						"type": "DatasetReference"
					},
					"name": "janOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Fact_Orders",
						"type": "DatasetReference"
					},
					"name": "SinkOrders"
				}
			],
			"transformations": [
				{
					"name": "ValidOrders",
					"description": "creating expression filter"
				},
				{
					"name": "derived"
				},
				{
					"name": "cast1"
				},
				{
					"name": "FinalColumn"
				}
			],
			"scriptLines": [
				"source(output(",
				"          OrderId as string,",
				"          CustomerId as string,",
				"          ProductId as string,",
				"          OrderDate as string,",
				"          Quantity as string,",
				"          UnitPrice as string,",
				"          Discount as string,",
				"          ShippingCost as string,",
				"          PaymentMethod as string,",
				"          OrderStatus as string,",
				"          Region as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['orders/year=2024/orders_*2024.csv']) ~> janOrders",
				"cast1 filter(!isNull(OrderId) && length(trim(OrderId)) > 0) ~> ValidOrders",
				"ValidOrders derive(GrossRevenue = Quantity * UnitPrice,",
				"          Discountamount = Quantity*UnitPrice*Discount,",
				"          NetRevenue = Quantity * UnitPrice *  (1-Discount),",
				"          TotalRevenue = (Quantity * UnitPrice *(1-Discount)+ShippingCost),",
				"          isDelivered = equals(OrderStatus,'Delivered')\r",
				",",
				"          OrderMonth = month(toDate(OrderDate,'yyy-MM-dd')),",
				"          OrderYear = year(toDate(OrderDate,'yyyy-MM-dd')),",
				"          OrderDateClean = toDate(OrderDate, 'yyyy-MM-dd')\r",
				") ~> derived",
				"janOrders cast(output(",
				"          Quantity as integer '000',",
				"          UnitPrice as integer '000',",
				"          Discount as double '0.00',",
				"          ShippingCost as integer '000'",
				"     ),",
				"     errors: true) ~> cast1",
				"derived select(mapColumn(",
				"          OrderId,",
				"          CustomerId,",
				"          ProductId,",
				"          OrderDateold = OrderDate,",
				"          Quantity,",
				"          UnitPrice,",
				"          Discount,",
				"          ShippingCost,",
				"          PaymentMethod,",
				"          OrderStatus,",
				"          Region,",
				"          GrossRevenue,",
				"          Discountamount,",
				"          NetRevenue,",
				"          TotalRevenue,",
				"          isDelivered,",
				"          OrderMonth,",
				"          OrderYear,",
				"          OrderDate = OrderDateClean",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> FinalColumn",
				"FinalColumn sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Orderid as string,",
				"          CustomerId as string,",
				"          Productid as string,",
				"          Customername as string,",
				"          Productname as string,",
				"          Cetagory as string,",
				"          Orderdate as date,",
				"          Ordermonth as integer,",
				"          OrderYear as integer,",
				"          Quentity as integer,",
				"          UnitPrice as decimal(10,2),",
				"          Discountpct as decimal(10,2),",
				"          Discountamount as decimal(10,2),",
				"          GrossRevenue as decimal(10,2),",
				"          ShippingCost as decimal(10,2),",
				"          Netrevenue as decimal(10,2),",
				"          CostofGoods as decimal(10,2),",
				"          GrossProfit as decimal(10,2),",
				"          PaymentMethord as string,",
				"          Orderstatus as string,",
				"          Isdelivered as boolean,",
				"          Region as string,",
				"          LoadAt as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Orderid = OrderId,",
				"          CustomerId,",
				"          Productid = ProductId,",
				"          Orderdate = OrderDate,",
				"          Ordermonth = OrderMonth,",
				"          OrderYear,",
				"          UnitPrice,",
				"          Discountamount,",
				"          GrossRevenue,",
				"          ShippingCost,",
				"          Netrevenue = NetRevenue,",
				"          Orderstatus = OrderStatus,",
				"          Isdelivered = isDelivered,",
				"          Region",
				"     )) ~> SinkOrders"
			]
		}
	}
}